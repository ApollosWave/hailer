{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "ruby",
  "include-component-in-tag": false,
  "packages": {
    ".": {
      "package-name": "hailer",
      "version-file": "lib/hailer/version.rb",
      "extra-files": [
        {
          "type": "generic",
          "path": "Cargo.toml"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value=='hailer')].version"
        }
      ]
    }
  }
}
